model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

/// Calendar Tests and more
queryGroup 'Demo Queries'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Transform File from Sales Data'

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Transform File from Sales Data\Helper Queries'

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Territory Lookup","Product Lookup","Product Categories Lookup","Product Subcategories Lookup","Largest Asset Management Firms","Customer Lookup","Calendar Lookup","Calendar Test Table","Rolling Calendar","Product Category Sales (Unpivot Demo)","Sales Data","Parameter1","Transform Sample File","Sample File","Transform File","Returns Data","_Measures"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","CalcGroup","DevMode"]

ref table 'Territory Lookup'
ref table 'Product Lookup'
ref table 'Product Categories Lookup'
ref table 'Product Subcategories Lookup'
ref table 'Customer Lookup'
ref table 'Calendar Lookup'
ref table 'Sales Data'
ref table 'Returns Data'
ref table _Measures
ref table 'Price Adjustment (%)'
ref table 'Product Metric Selection'
ref table 'Customer Metric Selection'
ref table 'Time Intelligence'
ref table 'Measure Selector'
ref table 'Model Measures'
ref table 'Model Tables'
ref table 'Model Columns'
ref table 'Model Relationships'

ref role Europe
ref role 'North America'
ref role Pacific

ref cultureInfo en-US

