expression 'Largest Asset Management Firms' =
		let
		    Source = Web.BrowserContents("https://en.wikipedia.org/wiki/list_of_asset_management_firms"),
		    #"Extracted Table From Html" = Html.Table(Source, {{"Column1", "TABLE[id='mwHQ'] > * > TR > :nth-child(1)"}, {"Column2", "TABLE[id='mwHQ'] > * > TR > :nth-child(2)"}, {"Column3", "TABLE[id='mwHQ'] > * > TR > :nth-child(3)"}}, [RowSelector="TABLE[id='mwHQ'] > * > TR"]),
		    #"Changed Type" = Table.TransformColumnTypes(#"Extracted Table From Html",{{"Column1", type text}, {"Column2", type text}, {"Column3", type text}}),
		    #"Promoted Headers" = Table.PromoteHeaders(#"Changed Type", [PromoteAllScalars=true]),
		    #"Changed Type1" = Table.TransformColumnTypes(#"Promoted Headers",{{"Firm/company", type text}, {"AUM in 2025[2]", type text}, {"Country", type text}}),
		    #"Reordered Columns" = Table.ReorderColumns(#"Changed Type1",{"Firm/company", "Country", "AUM in 2025[2]"}),
		    #"Added Custom" = Table.AddColumn(#"Reordered Columns", "Custom", each let
		    valor = Text.Remove([#"AUM in 2025[2]"], "$"),
		    numero = Number.From(Text.Start(valor, Text.Length(valor)-1)),
		    sufijo = Text.End(valor,1)
		in
		    if sufijo = "T" then numero * 1000
		    else if sufijo = "B" then numero
		    else null),
		    #"Renamed Columns" = Table.RenameColumns(#"Added Custom",{{"Custom", "AUM (billion USD)"}}),
		    #"Reordered Columns1" = Table.ReorderColumns(#"Renamed Columns",{"Firm/company", "Country", "AUM (billion USD)", "AUM in 2025[2]"}),
		    #"Changed Type2" = Table.TransformColumnTypes(#"Reordered Columns1",{{"AUM (billion USD)", Int64.Type}}),
		    #"Added Index" = Table.AddIndexColumn(#"Changed Type2", "Index", 1, 1, Int64.Type),
		    #"Renamed Columns1" = Table.RenameColumns(#"Added Index",{{"Index", "Rank"}}),
		    #"Reordered Columns2" = Table.ReorderColumns(#"Renamed Columns1",{"Rank", "Firm/company", "Country", "AUM (billion USD)", "AUM in 2025[2]"}),
		    #"Filtered Rows" = Table.SelectRows(#"Reordered Columns2", each ([#"Firm/company"] <> null)),
		    #"Removed Columns" = Table.RemoveColumns(#"Filtered Rows",{"AUM in 2025[2]"})
		in
		    #"Removed Columns"
	lineageTag: 17b22d2e-a34b-4ddd-a7e3-632c309415b5
