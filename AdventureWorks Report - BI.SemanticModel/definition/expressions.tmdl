expression 'Calendar Test Table' =
		let
		    FechaInicial = #date(2025, 1, 1),
		    FechaFinal = Date.From(DateTime.LocalNow()),
		    CantidadDias = Duration.Days(FechaFinal - FechaInicial) + 1,
		    ListaFechas = List.Dates(
		        FechaInicial,
		        CantidadDias,
		        #duration(1, 0, 0, 0)
		    ),
		    TablaFechas = Table.FromList(
		        ListaFechas,
		        Splitter.SplitByNothing(),
		        {"Date"}
		    ),
		    TipoFecha = Table.TransformColumnTypes(
		        TablaFechas,
		        {{"Date", type date}}
		    )
		in
		    TipoFecha
	lineageTag: 32cc6892-cd93-431b-8041-e224628ff0a9
	queryGroup: 'Demo Queries'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

