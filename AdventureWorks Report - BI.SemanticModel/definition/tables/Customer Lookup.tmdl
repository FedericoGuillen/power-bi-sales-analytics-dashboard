	column 'Is Parent ?' =
			
			IF(
			    'Customer Lookup'[TotalChildren] > 0,
			    "Yes",
			    "No"
			)
		lineageTag: c23fb589-a96d-44fe-8bfd-70afd2139b72
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Customer Priority' = ```
			
			IF(
			    'Customer Lookup'[Is Parent ?] == "Yes" && 'Customer Lookup'[AnnualIncome] > 100000,
			    "Priority",
			    "Standard"
			)
			
			```
		lineageTag: 828b8748-3498-48e6-965f-ec05eff4171b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Income Level' =
			
			SWITCH(
			    TRUE(),
			    'Customer Lookup'[AnnualIncome] >= 150000, "Very High",
			    'Customer Lookup'[AnnualIncome] >= 100000, "High",
			    'Customer Lookup'[AnnualIncome] >= 50000, "Average",
			    "Low"
			)
		lineageTag: 8af7b565-99b5-454f-bc21-1ba65933a2c9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Education Category' =
			
			SWITCH(
			    'Customer Lookup'[EducationLevel],
			    "High School","High School",
			    "Partial High School", "High School",
			    "Bachelors", "Undergrad",
			    "Partial College", "Undergrad",
			    "Graduate Degree", "Graduate"
			)
		lineageTag: f1d0053d-39e6-4475-b1cb-1f62d1c2e239
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Customer Full Name (CC)' =
			
			'Customer Lookup'[Prefix] & " " & 'Customer Lookup'[FirstName] & " " & 'Customer Lookup'[LastName]
		lineageTag: 4d811ff5-a6a9-4da6-8074-0d25b6cfae69
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Birth Year' =
			
			YEAR(
			    'Customer Lookup'[BirthDate]
			)
		formatString: 0
		lineageTag: 96638588-a51f-41df-bc48-c51a4b72da0d
